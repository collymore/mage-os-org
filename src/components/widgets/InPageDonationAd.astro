---
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  dismissalKey?: string;
}

const { id, dismissalKey } = Astro.props;
const titleId = `${id}-title`;
const membershipUrl = 'https://opencollective.com/mage-os/contribute/community-member-44722/checkout';
---

<aside
  id={id}
  class="relative scroll-mt-24 border-y border-orange-300 bg-orange-50 py-10 dark:border-orange-500/30 dark:bg-slate-900"
  aria-labelledby={titleId}
  data-donation-ad-variant="in_page"
  data-donation-ad-dismissal-key={dismissalKey}
>
  {
    dismissalKey && (
      <button
        type="button"
        class="absolute right-3 top-3 rounded-full p-2 text-slate-600 transition hover:bg-orange-100 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-orange-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:focus:ring-orange-400 sm:right-5"
        aria-label="Dismiss Mage-OS membership message"
        data-donation-ad-dismiss
        hidden
      >
        <Icon name="tabler:x" class="h-6 w-6" aria-hidden="true" />
      </button>
    )
  }
  <div
    class:list={[
      'mx-auto flex max-w-6xl flex-col gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8',
      dismissalKey && 'pr-14 sm:pr-16 lg:pr-16',
    ]}
  >
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-700 dark:text-orange-300">Support Mage-OS</p>
      <h2 id={titleId} class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 dark:text-white">
        Built by the community. Backed by you.
      </h2>
      <p class="mt-3 text-base leading-7 text-slate-700 dark:text-slate-300">
        Membership funds features, grants, docs, and events—and gives you a vote.
      </p>
    </div>
    <a
      href={membershipUrl}
      data-donation-ad-action="join"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-lg bg-orange-600 px-6 py-3 font-bold text-white shadow-sm transition hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:ring-offset-2 focus:ring-offset-orange-50 dark:bg-orange-500 dark:text-slate-950 dark:hover:bg-orange-400 dark:focus:ring-orange-400 dark:focus:ring-offset-slate-900 lg:self-auto"
    >
      Join from €10/year
      <Icon name="tabler:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</aside>

<script is:inline define:vars={{ id, dismissalKey }}>
  // Restore dismissal before the bundled tracking script initializes.
  if (dismissalKey) {
    try {
      const ad = document.getElementById(id);
      if (ad && localStorage.getItem(dismissalKey) === 'true') ad.hidden = true;
    } catch {
      // The ad is still usable if storage is unavailable.
    }
  }
</script>
